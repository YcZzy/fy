.section-title.small { font-size: 28rpx; }
.duration-chips { margin-top: 22rpx; }
.completion-chips { margin-top: 20rpx; }
.custom-duration { display: flex; align-items: center; gap: 12rpx; margin-top: 22rpx; color: var(--muted); font-size: 24rpx; }
.custom-duration input { width: 170rpx; padding: 16rpx 20rpx; border-radius: 18rpx; background: rgba(234,225,213,.45); color: var(--ink); }
.feeling-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; margin-top: 20rpx; }
.feeling { display: flex; flex-direction: column; align-items: center; gap: 10rpx; padding: 22rpx 8rpx; border-radius: 24rpx; color: var(--muted); background: rgba(255,255,255,.56); border: 1rpx solid rgba(93,74,58,.08); font-size: 22rpx; }
.feeling-symbol { width: 55rpx; height: 55rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--oat); color: var(--caramel-deep); font-size: 21rpx; }
.feeling.active { color: #fff; background: var(--ink); }
.feeling.active .feeling-symbol { background: var(--gold); color: var(--ink); }
.note-input { width: 100%; min-height: 150rpx; line-height: 1.6; }
.again-row { display: flex; align-items: center; justify-content: space-between; padding-top: 22rpx; border-top: 1rpx solid rgba(93,74,58,.08); color: var(--muted); font-size: 24rpx; }
.again-actions { display: flex; gap: 12rpx; }
.again { padding: 10rpx 16rpx; border-radius: 999rpx; background: var(--oat); }
.again.active { color: #fff; background: var(--olive); }
.attachment-row { display: flex; gap: 16rpx; margin-top: 24rpx; }
.attachment { flex: 1; display: flex; align-items: center; justify-content: center; gap: 12rpx; min-height: 84rpx; padding: 0 16rpx; border-radius: 22rpx; background: rgba(255,255,255,.55); color: var(--muted); font-size: 24rpx; }
.attachment-icon { color: var(--caramel); font-size: 31rpx; }
.preview-wrap { position: relative; margin-top: 18rpx; }
.photo-preview { width: 100%; height: 300rpx; border-radius: 24rpx; }
.remove { color: var(--brick); font-size: 23rpx; }
.preview-wrap .remove { position: absolute; top: 16rpx; right: 16rpx; padding: 10rpx 16rpx; border-radius: 999rpx; background: rgba(255,250,243,.9); }
.location-preview { display: flex; justify-content: space-between; margin-top: 14rpx; padding: 18rpx 22rpx; border-radius: 18rpx; background: rgba(255,255,255,.55); font-size: 24rpx; }
.save-btn { margin-top: 36rpx; }
.skip-btn { margin-top: 12rpx; width: 100%; color: var(--muted); }
