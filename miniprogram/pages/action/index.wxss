.action-page { text-align: center; padding-top: 80rpx; }
.action-orbit { width: 154rpx; height: 154rpx; margin: 0 auto 34rpx; padding: 14rpx; box-sizing: border-box; border-radius: 50%; border: 1rpx solid rgba(185,120,80,.25); box-shadow: 0 18rpx 50rpx rgba(185,120,80,.12); }
.action-orbit-inner { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #fffaf4; background: linear-gradient(145deg, #c99069, #9f6241); font-size: 42rpx; }
.action-title { margin-top: 20rpx; font-size: 48rpx; line-height: 1.38; font-weight: 650; }
.action-meta { margin-top: 14rpx; color: var(--muted); font-size: 25rpx; }
.action-detail { margin-top: 52rpx; padding: 30rpx; text-align: left; }
.detail-row { display: flex; flex-direction: column; gap: 12rpx; }
.detail-label { color: var(--caramel-deep); font-size: 22rpx; letter-spacing: 2rpx; }
.detail-value { line-height: 1.65; }
.location-note { margin-top: 22rpx; color: var(--blue-grey); font-size: 23rpx; line-height: 1.6; }
.start-panel { display: flex; flex-direction: column; gap: 18rpx; margin-top: 50rpx; }
.start-note { margin-bottom: 4rpx; color: var(--muted); font-size: 23rpx; }
.timer-panel { margin-top: 42rpx; padding: 34rpx 28rpx 24rpx; display: flex; flex-direction: column; }
.timer-status { color: var(--muted); font-size: 23rpx; }
.timer-value { margin: 16rpx 0 28rpx; font-size: 74rpx; line-height: 1; font-weight: 320; letter-spacing: 4rpx; font-variant-numeric: tabular-nums; }
.timer-actions { display: flex; gap: 16rpx; }
.timer-actions button { flex: 1; }
.cancel { margin-top: 18rpx; color: var(--muted); }
