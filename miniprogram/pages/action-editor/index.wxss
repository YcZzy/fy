.field-label.first { margin-top: 0; }
.picker-value { display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; height: 88rpx; padding: 0 26rpx 0 24rpx; border-radius: 22rpx; background: rgba(255,255,255,.62); border: 1rpx solid rgba(93,74,58,.1); }
.picker-text { min-width: 0; overflow: hidden; line-height: 1.4; white-space: nowrap; text-overflow: ellipsis; }
.picker-arrow { flex-shrink: 0; width: 13rpx; height: 13rpx; margin: -7rpx 2rpx 0 22rpx; border-right: 3rpx solid var(--muted); border-bottom: 3rpx solid var(--muted); transform: rotate(45deg); }
.minutes-input { display: flex; align-items: center; gap: 12rpx; color: var(--muted); }
.minutes-input input { width: 180rpx; padding: 18rpx 20rpx; border-radius: 18rpx; background: rgba(255,255,255,.62); }
.plan-options { overflow: hidden; border-radius: 20rpx; background: rgba(255,255,255,.5); }
.plan-option { display: flex; align-items: center; justify-content: space-between; padding: 21rpx 23rpx; border-bottom: 1rpx solid rgba(93,74,58,.07); }
.plan-option:last-child { border-bottom: 0; }
.plan-option text:last-child { color: var(--muted); font-size: 21rpx; }
.plan-option.active { background: rgba(117,128,107,.1); }
.plan-option.active text:last-child { color: var(--olive); font-weight: 600; }
.plan-empty { padding: 22rpx; color: var(--muted); background: rgba(255,255,255,.4); border-radius: 20rpx; font-size: 22rpx; }
.save-action, .delete-action { width: 100%; margin-top: 24rpx; }
