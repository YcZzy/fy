<view class="page moon-page"><view class="page-content">
  <text class="eyebrow">风月 · 多种生活并行</text>
  <view class="hero-title">最近想靠近什么</view>
  <view class="hero-subtitle">没有进度条。次数、时长和感受，只用来回望。</view>

  <view class="workspace-tabs"><button class="{{workspaceTab === 'plans' ? 'active' : ''}}" data-value="plans" bindtap="setWorkspaceTab">计划</button><button class="{{workspaceTab === 'wishes' ? 'active' : ''}}" data-value="wishes" bindtap="setWorkspaceTab">想做</button><button class="{{workspaceTab === 'actions' ? 'active' : ''}}" data-value="actions" bindtap="setWorkspaceTab">行动库</button></view>
  <view wx:if="{{workspaceTab === 'plans'}}">
  <view class="section" wx:if="{{focusedPlans.length}}">
    <view class="section-head"><text class="section-title">最近关注</text><text class="section-note">最多三个</text></view>
    <scroll-view scroll-x class="focus-scroll" enhanced show-scrollbar="{{false}}">
      <view class="focus-row">
        <view wx:for="{{focusedPlans}}" wx:key="id" class="focus-card" data-id="{{item.id}}" bindtap="openPlan">
          <view class="focus-top"><text class="tag">{{item.statusLabel}}</text><text class="focus-count">{{item.count}} 次</text></view>
          <view class="focus-name">{{item.name}}</view>
          <view class="focus-last">最近：{{item.lastAction}}</view>
          <view class="focus-meta">{{item.duration}} · {{item.lastFeeling}}</view>
          <view class="small-action">查看计划 <text>→</text></view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="section">
    <view class="section-head"><text class="section-title">全部计划</text><button class="ghost-btn" bindtap="addPlan">＋ 新计划</button></view>
    <scroll-view scroll-x class="filter-scroll" show-scrollbar="{{false}}"><view class="filter-row"><view wx:for="{{filters}}" wx:key="value" class="chip {{filter === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setFilter">{{item.label}}</view></view></scroll-view>
    <view wx:if="{{plans.length}}" class="plan-list solid-card">
      <view wx:for="{{plans}}" wx:key="id" class="plan-row" data-id="{{item.id}}" bindtap="openPlan">
        <view class="plan-dot"></view><view class="plan-copy"><text class="plan-name">{{item.name}}</text><text class="plan-meta">{{item.statusLabel}} · {{item.count}} 次 · {{item.duration}}</text></view><text class="chevron">›</text>
      </view>
    </view>
    <view wx:else class="empty">“{{filterLabel}}”下还没有计划。<view>可以创建一段想体验的生活。</view></view>
  </view>

  </view>
  <view wx:if="{{workspaceTab === 'wishes'}}">
  <view class="section">
    <view class="section-head"><text class="section-title">想做清单</text><button class="ghost-btn" bindtap="addWish">＋ 记一件</button></view>
    <view class="wish-list glass-card">
      <view wx:for="{{wishes}}" wx:key="id" class="wish-row">
        <view class="wish-mark"></view><text class="wish-text">{{item.text}}</text>
        <view class="wish-menu"><text data-id="{{item.id}}" data-action="edit" bindtap="wishAction">编辑</text><text data-id="{{item.id}}" data-action="chat" bindtap="wishAction">展开</text><text data-id="{{item.id}}" data-action="plan" bindtap="wishAction">转计划</text><text data-id="{{item.id}}" data-action="delete" bindtap="wishAction">删</text></view>
      </view>
      <view wx:if="{{!wishes.length}}" class="empty">还没有记下模糊的愿望。</view>
    </view>
  </view>

  </view>
  <view wx:if="{{workspaceTab === 'actions'}}" class="section">
    <view class="section-head"><text class="section-title">具体行动</text><button class="ghost-btn" bindtap="addAction">＋ 新行动</button></view>
    <input class="input" value="{{actionQuery}}" placeholder="搜索行动名称" bindinput="onActionSearch"/>
    <view class="chips domain-filters"><view class="chip {{!actionDomainId ? 'active' : ''}}" bindtap="clearActionFilters">全部板块</view><view wx:for="{{domains}}" wx:key="id" class="chip {{actionDomainId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="filterDomain">{{item.name}}</view></view>
    <view class="action-list solid-card">
      <view wx:for="{{actions}}" wx:key="id" class="library-row"><view class="library-copy" data-id="{{item.id}}" bindtap="openAction"><text class="library-name">{{item.name}}</text><text class="library-meta">{{item.domainName}} · {{item.minutes}} 分钟</text></view><view class="library-actions"><text data-id="{{item.id}}" catchtap="editAction">编辑</text><text data-id="{{item.id}}" catchtap="deleteAction">删除</text></view></view>
      <view wx:if="{{!actions.length && (actionQuery || actionDomainId)}}" class="empty">没有匹配的行动。<view>可以清除筛选，或添加一个。</view></view>
      <view wx:if="{{!actions.length && !actionQuery && !actionDomainId}}" class="empty">这里会收下你想做的事。<view>可以自己添加，也可以请风月帮你整理。</view></view>
    </view>
  </view>
  <view class="ask-card glass-card" bindtap="openChat"><view class="ask-symbol">风</view><view><text class="ask-title">问风月</text><text class="ask-sub">把一句模糊的想法，展开一点</text></view><text class="chevron">›</text></view>
</view></view>
