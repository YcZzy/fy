<view class="page moon-page"><view class="page-content">
  <text class="eyebrow">风月 · 多种生活并行</text>
  <view class="hero-title">最近想靠近什么</view>
  <view class="hero-subtitle">没有进度条。次数、时长和感受，只用来回望。</view>

  <view class="section" wx:if="{{focusedPlans.length}}">
    <view class="section-head"><text class="section-title">最近关注</text><text class="section-note">建议 1—3 个</text></view>
    <view wx:for="{{focusedPlans}}" wx:key="id" class="focus-plan glass-card" data-id="{{item.id}}" bindtap="openPlan">
      <view class="focus-line"><text class="tag">{{item.statusLabel}}</text><text class="focus-arrow">↗</text></view>
      <view class="focus-title">{{item.name}}</view>
      <view class="focus-stats"><text>{{item.count}} 次体验</text><text>{{item.duration}}</text></view>
    </view>
  </view>

  <view class="section">
    <view class="section-head"><text class="section-title">全部计划</text><button class="ghost-btn" bindtap="addPlan">＋ 新计划</button></view>
    <scroll-view scroll-x class="filter-scroll" show-scrollbar="{{false}}"><view class="filter-row"><view wx:for="{{filters}}" wx:key="value" class="chip {{filter === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setFilter">{{item.label}}</view></view></scroll-view>
    <view wx:if="{{plans.length}}" class="plan-list solid-card">
      <view wx:for="{{plans}}" wx:key="id" class="plan-row" data-id="{{item.id}}" bindtap="openPlan">
        <view class="plan-dot"></view><view class="plan-copy"><text class="plan-name">{{item.name}}</text><text class="plan-meta">{{item.statusLabel}} · {{item.count}} 次 · {{item.duration}}</text></view><text class="chevron">›</text>
      </view>
    </view>
    <view wx:else class="empty">这里还没有计划。<br/>想做的事情可以慢慢长出来。</view>
  </view>

  <view class="section">
    <view class="section-head"><text class="section-title">想做清单</text><button class="ghost-btn" bindtap="addWish">＋ 记一件</button></view>
    <view class="wish-list glass-card">
      <view wx:for="{{wishes}}" wx:key="id" class="wish-row">
        <view class="wish-mark"></view><text class="wish-text">{{item.text}}</text>
        <view class="wish-menu"><text data-id="{{item.id}}" data-action="chat" bindtap="wishAction">展开</text><text data-id="{{item.id}}" data-action="plan" bindtap="wishAction">转计划</text><text data-id="{{item.id}}" data-action="delete" bindtap="wishAction">删</text></view>
      </view>
      <view wx:if="{{!wishes.length}}" class="empty">还没有记下模糊的愿望。</view>
    </view>
  </view>

  <view class="section">
    <view class="section-head"><text class="section-title">生活板块</text><text class="section-note">{{domains.length}} 个板块</text></view>
    <view class="domain-grid">
      <view wx:for="{{domains}}" wx:key="id" class="domain-card solid-card {{actionDomainId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="filterDomain"><view class="domain-icon" style="color: {{item.color}}">{{item.icon}}</view><text class="domain-name">{{item.name}}</text><text class="domain-count">{{item.actionCount}} 个行动</text></view>
    </view>
  </view>

  <view class="section">
    <view class="section-head" bindtap="toggleActions"><text class="section-title">全部行动库</text><text class="section-note">{{actions.length}} 个 {{showActions ? '收起' : '展开'}} ›</text></view>
    <view wx:if="{{showActions}}" class="action-list solid-card">
      <view class="action-tools"><input value="{{actionQuery}}" placeholder="搜索行动" bindinput="onActionSearch"/><text wx:if="{{actionQuery || actionDomainId}}" bindtap="clearActionFilters">清除筛选</text></view>
      <view wx:for="{{actions}}" wx:key="id" class="library-row">
        <view class="library-copy" data-id="{{item.id}}" bindtap="openAction"><text class="library-name">{{item.name}}</text><text class="library-meta">{{item.domainName}} · {{item.minutes}} 分钟</text></view>
        <view class="library-actions"><text data-id="{{item.id}}" catchtap="editAction">编辑</text><text class="hide-action" data-id="{{item.id}}" catchtap="hideAction">隐藏</text></view>
      </view>
      <view wx:if="{{!actions.length}}" class="empty">没有找到合适的行动。</view>
      <button class="secondary-btn add-action" bindtap="addAction">添加具体行动</button>
    </view>
  </view>

  <view class="ask-card glass-card" bindtap="openChat"><view class="ask-symbol">风</view><view><text class="ask-title">问风月</text><text class="ask-sub">把一句模糊的想法，展开一点</text></view><text class="chevron">›</text></view>
</view></view>
