.focus-plan { margin-bottom: 16rpx; padding: 27rpx; }
.focus-line { display: flex; justify-content: space-between; align-items: center; }
.focus-arrow { color: var(--caramel); }
.focus-title { margin-top: 18rpx; font-size: 33rpx; font-weight: 630; }
.focus-stats { display: flex; gap: 28rpx; margin-top: 14rpx; color: var(--muted); font-size: 23rpx; }
.filter-scroll { width: calc(100vw - 30rpx); margin-bottom: 18rpx; }
.filter-row { display: flex; gap: 12rpx; padding-right: 30rpx; }
.plan-list, .wish-list, .action-list { overflow: hidden; }
.plan-row { display: flex; align-items: center; padding: 25rpx 26rpx; border-bottom: 1rpx solid rgba(93,74,58,.07); }
.plan-row:last-child, .wish-row:last-child, .library-row:last-of-type { border-bottom: 0; }
.plan-dot { width: 10rpx; height: 10rpx; margin-right: 18rpx; border-radius: 50%; background: var(--olive); }
.plan-copy { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.plan-name { font-size: 28rpx; font-weight: 590; }
.plan-meta, .library-meta { color: var(--muted); font-size: 22rpx; }
.chevron { color: #a99f95; margin-left: auto; font-size: 42rpx; font-weight: 300; }
.wish-row { padding: 26rpx; border-bottom: 1rpx solid rgba(93,74,58,.07); }
.wish-mark { display: inline-block; width: 8rpx; height: 8rpx; margin-right: 14rpx; border-radius: 50%; background: var(--gold); }
.wish-text { line-height: 1.6; }
.wish-menu { display: flex; gap: 26rpx; margin: 18rpx 0 0 22rpx; color: var(--caramel-deep); font-size: 22rpx; }
.domain-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.domain-card { display: flex; flex-direction: column; padding: 24rpx; }
.domain-icon { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(234,225,213,.55); font-size: 21rpx; }
.domain-name { margin-top: 20rpx; font-weight: 600; }
.domain-count { margin-top: 6rpx; color: var(--muted); font-size: 21rpx; }
.library-row { display: flex; align-items: center; justify-content: space-between; padding: 23rpx 25rpx; border-bottom: 1rpx solid rgba(93,74,58,.07); }
.library-row>view { display: flex; flex-direction: column; gap: 8rpx; }
.library-name { font-size: 26rpx; }
.hide-action { color: var(--muted); font-size: 22rpx; }
.add-action { margin: 20rpx; min-height: 76rpx; }
.ask-card { display: flex; align-items: center; gap: 18rpx; margin-top: 42rpx; padding: 24rpx; }
.ask-symbol { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: var(--caramel); }
.ask-card>view:nth-child(2) { display: flex; flex-direction: column; gap: 5rpx; }
.ask-title { font-weight: 620; }
.ask-sub { color: var(--muted); font-size: 22rpx; }
