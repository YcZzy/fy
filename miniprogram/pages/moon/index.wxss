.moon-page {
  --tab-theme: #7595a5;
  --tab-theme-deep: #567789;
  --tab-theme-soft: #e2ecef;
  padding-bottom: calc(env(safe-area-inset-bottom) + 150rpx);
  background: linear-gradient(180deg, #edf3f4 0, #f1f2ef 390rpx, #f4efe7 800rpx);
}
.moon-page::before { background: rgba(117, 149, 165, .20); }
.moon-page::after { background: rgba(159, 185, 193, .12); }
.moon-page .eyebrow, .moon-page .ghost-btn, .moon-page .wish-menu, .moon-page .library-actions, .moon-page .action-tools { color: var(--tab-theme-deep); }
.moon-page .chip.active { background: var(--tab-theme); border-color: var(--tab-theme); box-shadow: 0 8rpx 20rpx rgba(86, 119, 137, .15); }
.moon-page .tag { color: var(--tab-theme-deep); background: rgba(117, 149, 165, .11); }
.moon-page .plan-dot { background: var(--tab-theme); }
.moon-page .domain-card.active { border-color: rgba(117, 149, 165, .42); box-shadow: inset 0 0 0 2rpx rgba(117, 149, 165, .12); }

.focus-scroll { width: calc(100vw - 30rpx); margin-right: -30rpx; }
.focus-row { display: flex; gap: 20rpx; padding-right: 30rpx; }
.focus-card { box-sizing: border-box; width: 490rpx; flex: 0 0 490rpx; padding: 26rpx; background: rgba(255, 255, 255, .42); border-radius: 26rpx; }
.focus-top { display: flex; align-items: center; justify-content: space-between; }
.focus-count { color: var(--muted); font-size: 22rpx; }
.focus-name { margin-top: 24rpx; font-size: 33rpx; font-weight: 630; }
.focus-last { margin-top: 12rpx; color: var(--ink); font-size: 23rpx; }
.focus-meta { margin-top: 10rpx; color: var(--muted); font-size: 23rpx; }
.small-action { box-sizing: border-box; width: 100%; margin-top: 25rpx; padding: 20rpx 0 0; color: var(--tab-theme-deep); border-top: 1rpx solid rgba(93,74,58,.08); font-size: 25rpx; line-height: 1.2; }
.filter-scroll { width: calc(100vw - 30rpx); margin-bottom: 18rpx; }
.filter-row { display: flex; gap: 12rpx; padding-right: 30rpx; }
.plan-list, .wish-list, .action-list { overflow: hidden; }
.plan-row { display: flex; align-items: center; padding: 25rpx 26rpx; border-bottom: 1rpx solid rgba(93,74,58,.07); }
.plan-row:last-child, .wish-row:last-child, .library-row:last-of-type { border-bottom: 0; }
.plan-dot { width: 10rpx; height: 10rpx; margin-right: 18rpx; border-radius: 50%; background: var(--olive); }
.plan-copy { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.plan-name { font-size: 28rpx; font-weight: 590; }
.plan-meta, .library-meta { color: var(--muted); font-size: 22rpx; }
.chevron { color: #a99f95; margin-left: auto; font-size: 42rpx; font-weight: 300; }
.wish-row { padding: 26rpx; border-bottom: 1rpx solid rgba(93,74,58,.07); }
.wish-mark { display: inline-block; width: 8rpx; height: 8rpx; margin-right: 14rpx; border-radius: 50%; background: var(--gold); }
.wish-text { line-height: 1.6; }
.wish-menu { display: flex; gap: 26rpx; margin: 18rpx 0 0 22rpx; color: var(--caramel-deep); font-size: 22rpx; }
.domain-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.domain-card { display: flex; flex-direction: column; padding: 24rpx; }
.domain-card.active { border-color: rgba(169,101,66,.35); box-shadow: inset 0 0 0 2rpx rgba(169,101,66,.12); }
.domain-icon { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(234,225,213,.55); font-size: 21rpx; }
.domain-name { margin-top: 20rpx; font-weight: 600; }
.domain-count { margin-top: 6rpx; color: var(--muted); font-size: 21rpx; }
.library-row { display: flex; align-items: center; justify-content: space-between; padding: 23rpx 25rpx; border-bottom: 1rpx solid rgba(93,74,58,.07); }
.library-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.library-name { font-size: 26rpx; }
.delete-action { color: var(--muted); font-size: 22rpx; }
.library-actions { display: flex; gap: 20rpx; margin-left: 16rpx; color: var(--caramel-deep); font-size: 22rpx; }
.action-tools { display: flex; align-items: center; gap: 18rpx; padding: 18rpx 22rpx; border-bottom: 1rpx solid rgba(93,74,58,.07); color: var(--caramel-deep); font-size: 22rpx; }
.action-tools input { flex: 1; padding: 14rpx 18rpx; border-radius: 18rpx; background: rgba(234,225,213,.45); }
.add-action { margin: 20rpx; min-height: 76rpx; }
.ask-card { display: flex; align-items: center; gap: 18rpx; margin-top: 42rpx; padding: 24rpx; }
.ask-symbol { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: var(--tab-theme); }
.ask-card>view:nth-child(2) { display: flex; flex-direction: column; gap: 5rpx; }
.ask-title { font-weight: 620; }
.ask-sub { color: var(--muted); font-size: 22rpx; }

.workspace-tabs { display: flex; gap: 6rpx; padding: 6rpx; margin-top: 30rpx; background: rgba(226,236,239,.8); border-radius: 999rpx; }
.workspace-tabs button { flex: 1; min-width: 0; min-height: 80rpx; background: transparent; color: var(--tab-theme-deep); font-size: 27rpx; }
.workspace-tabs button.active { background: #fff; box-shadow: 0 6rpx 18rpx rgba(86,119,137,.12); font-weight: 600; }
.domain-filters { margin: 24rpx 0; }
.domain-filters .chip { padding: 16rpx 18rpx; }
.library-actions text, .wish-menu text { display: inline-flex; align-items: center; min-height: 76rpx; padding: 0 8rpx; }
.library-actions { flex-shrink: 0; gap: 8rpx; }
.wish-menu { flex-wrap: wrap; gap: 8rpx 16rpx; margin-top: 8rpx; }
.plan-copy { min-width: 0; }
