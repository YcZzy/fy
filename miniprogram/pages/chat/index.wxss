.chat-page { height: 100vh; display: flex; flex-direction: column; box-sizing: border-box; padding-top: 20rpx; background: var(--paper); }
.chat-head { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 30rpx 22rpx; }
.chat-head>view { display: flex; flex-direction: column; gap: 6rpx; }
.chat-title { font-size: 38rpx; font-weight: 650; }
.message-scroll { flex: 1; min-height: 0; }
.message-inner { padding: 0 28rpx; }
.chat-welcome { display: flex; flex-direction: column; align-items: center; padding: 75rpx 18rpx 30rpx; text-align: center; }
.wind-mark { width: 96rpx; height: 96rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 30rpx; border-radius: 50%; color: #fff; background: linear-gradient(145deg, #c58a63, #9f6241); box-shadow: 0 18rpx 40rpx rgba(169,101,66,.22); }
.welcome-line { margin-bottom: 12rpx; font-size: 32rpx; font-weight: 620; }
.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 13rpx; width: 100%; margin-top: 40rpx; }
.quick-item { padding: 20rpx 14rpx; border-radius: 20rpx; background: rgba(255,255,255,.62); border: 1rpx solid rgba(93,74,58,.08); color: var(--muted); font-size: 24rpx; }
.history-list { width: 100%; margin-top: 38rpx; text-align: left; }
.history-title { color: var(--muted); font-size: 22rpx; letter-spacing: 2rpx; }
.history-row { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 4rpx; border-bottom: 1rpx solid rgba(93,74,58,.07); }
.history-name { flex: 1; font-size: 25rpx; }.history-delete { color: var(--muted); font-size: 21rpx; }
.message-row { display: flex; margin-top: 22rpx; }
.message-row.user { justify-content: flex-end; }
.bubble { max-width: 78%; padding: 21rpx 24rpx; border-radius: 25rpx 25rpx 25rpx 7rpx; background: rgba(255,252,247,.85); box-shadow: 0 8rpx 28rpx rgba(90,72,55,.07); line-height: 1.65; }
.user .bubble { color: #fffaf4; background: var(--ink); border-radius: 25rpx 25rpx 7rpx 25rpx; }
.bubble.failed { color: var(--muted); }
.typing { display: flex; gap: 8rpx; padding: 27rpx; }
.typing text { width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--caramel); animation: dot 1.2s infinite; }
.typing text:nth-child(2) { animation-delay: .15s; }.typing text:nth-child(3) { animation-delay: .3s; }
.draft-card { display: flex; flex-direction: column; gap: 13rpx; margin-top: 22rpx; padding: 26rpx; }
.draft-eyebrow { color: var(--olive); font-size: 21rpx; letter-spacing: 2rpx; }
.draft-name { font-size: 30rpx; font-weight: 620; }
.draft-why, .draft-meta { color: var(--muted); font-size: 23rpx; line-height: 1.55; }
.draft-actions { display: flex; gap: 10rpx; margin-top: 10rpx; }
.draft-actions button { flex: 1; padding: 0 10rpx; }
.draft-card button { min-height: 72rpx; font-size: 24rpx; }
.scroll-spacer { height: 36rpx; }
.composer { display: flex; align-items: flex-end; gap: 14rpx; padding: 18rpx 24rpx calc(env(safe-area-inset-bottom) + 18rpx); background: rgba(251,247,241,.94); border-top: 1rpx solid rgba(93,74,58,.07); backdrop-filter: blur(16rpx); }
.composer textarea { flex: 1; max-height: 160rpx; padding: 19rpx 22rpx; box-sizing: border-box; border-radius: 25rpx; background: #fff; line-height: 1.5; }
.send-btn { width: 74rpx; height: 74rpx; flex: 0 0 74rpx; color: #fff; background: var(--caramel); font-size: 34rpx; }
.send-btn[disabled] { opacity: .38; }
@keyframes dot { 0%, 60%, 100% { opacity: .3; transform: translateY(0); } 30% { opacity: 1; transform: translateY(-5rpx); } }
