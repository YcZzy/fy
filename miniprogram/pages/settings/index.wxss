.settings-group { overflow: hidden; }
.setting-row { display: flex; align-items: center; justify-content: space-between; padding: 26rpx; border-bottom: 1rpx solid rgba(93,74,58,.07); }
.setting-row:last-child { border-bottom: 0; }
.setting-row>view { display: flex; flex-direction: column; gap: 8rpx; max-width: 520rpx; }
.setting-title { font-size: 27rpx; font-weight: 590; }
.setting-sub { color: var(--muted); font-size: 22rpx; line-height: 1.5; }
.status { padding: 8rpx 15rpx; border-radius: 999rpx; color: var(--muted); background: var(--oat); font-size: 21rpx; }
.status.ready { color: #fff; background: var(--olive); }
.chevron { color: #aaa197; font-size: 40rpx; }
.data-overview { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 18rpx; padding: 28rpx 12rpx; }
.data-overview view { display: flex; flex-direction: column; align-items: center; gap: 8rpx; border-right: 1rpx solid rgba(93,74,58,.08); }
.data-overview view:last-child { border-right: 0; }
.data-overview text:first-child { font-size: 38rpx; }.data-overview text:last-child { color: var(--muted); font-size: 22rpx; }
.delete-all { width: 100%; margin-top: 34rpx; }
.privacy-note { margin: 28rpx 16rpx 0; color: var(--muted); font-size: 22rpx; line-height: 1.7; text-align: center; }
