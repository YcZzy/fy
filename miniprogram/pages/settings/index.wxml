<view class="page settings-page context-page theme-{{theme}}"><view class="page-content">
  <text class="eyebrow">你的数据，只属于你</text><view class="hero-title">设置与隐私</view><view class="hero-subtitle">随时调整偏好，也能了解数据是否已保存。</view>
  <view class="section glass-card settings-group"><view class="setting-row"><view><text class="setting-title">{{cloudReady ? '云端同步' : '本机存储'}}</text><text class="setting-sub">{{syncInfo}}</text><text wx:if="{{cloudReady}}" class="setting-sub">最近成功同步：{{lastSynced}}</text><text wx:if="{{pendingPhotos}}" class="setting-sub">{{pendingPhotos}} 张照片仅保存在本机，等待上传</text></view></view><button wx:if="{{cloudReady && !deletionPending}}" class="ghost-btn" loading="{{syncing}}" disabled="{{syncing}}" bindtap="retrySync">立即同步 / 重试</button></view>
  <view wx:if="{{!deletionPending}}">
    <view class="section glass-card settings-group"><view class="setting-row" bindtap="editInterests"><view><text class="setting-title">最近的兴趣</text><text class="setting-sub">{{interests}}</text></view><text class="chevron">›</text></view><view class="setting-row" bindtap="openLocationSettings"><view><text class="setting-title">位置权限</text><text class="setting-sub">查看或修改微信授权</text></view><text class="chevron">›</text></view></view>
    <view class="section"><view class="section-title">我的数据</view><view class="data-overview solid-card"><view><text>{{counts.plans}}</text><text>计划</text></view><view><text>{{counts.footprints}}</text><text>足迹</text></view><view><text>{{counts.conversations}}</text><text>AI 对话</text></view></view></view>
    <view class="section glass-card settings-group"><view class="setting-row" bindtap="showHelp"><text>使用说明</text><text class="chevron">›</text></view><view class="setting-row" bindtap="showPrivacy"><text>数据如何使用</text><text class="chevron">›</text></view><button class="setting-row feedback-row" open-type="feedback"><text>意见反馈</text><text class="chevron">›</text></button><view class="setting-row" bindtap="clearChats"><text>清空全部 AI 对话</text><text class="chevron">›</text></view></view>
  </view>
  <button class="danger-btn delete-all" loading="{{deleting}}" disabled="{{deleting}}" bindtap="deleteAll">{{deletionPending ? '继续删除全部数据' : '删除全部个人数据'}}</button>
  <view class="privacy-note">不建立排名、成长分或娱乐超标判断。<view>删除足迹时，会一并处理它的照片与位置。</view></view>
</view></view>
