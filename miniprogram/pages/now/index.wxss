.now-page {
  --tab-theme: #c47d60;
  --tab-theme-deep: #9f6048;
  --tab-theme-soft: #f1dfd5;
  padding-bottom: calc(env(safe-area-inset-bottom) + 150rpx);
  background: linear-gradient(180deg, #f7f0ea 0, #f4efe8 390rpx, #f4efe7 760rpx);
}
.now-page::before { background: rgba(214, 154, 123, .20); }
.now-page::after { background: rgba(231, 190, 163, .13); }
.now-page .eyebrow, .now-page .ghost-btn, .now-page .small-action { color: var(--tab-theme-deep); }
.now-page .chip.active { background: var(--tab-theme); border-color: var(--tab-theme); box-shadow: 0 8rpx 20rpx rgba(159, 96, 72, .16); }
.now-page .primary-btn { background: linear-gradient(135deg, #cf9478, var(--tab-theme)); box-shadow: 0 16rpx 34rpx rgba(159, 96, 72, .20); }
.now-page .tag { color: var(--tab-theme-deep); background: rgba(196, 125, 96, .11); }

.hero-row { display: flex; justify-content: space-between; gap: 24rpx; }
.settings { width: 62rpx; height: 62rpx; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,.55); border-radius: 50%; }
.settings-icon { display: block; width: 34rpx; height: 34rpx; }
.settings-hover { opacity: .65; }
.active-card { margin-top: 28rpx; padding: 24rpx 26rpx; background: rgba(45,41,37,.92); color: #fffaf3; }
.active-dot { display: inline-block; width: 12rpx; height: 12rpx; margin-right: 12rpx; border-radius: 50%; background: #d5b783; }
.active-label { color: rgba(255,250,243,.68); font-size: 22rpx; }
.active-main { margin-top: 12rpx; display: flex; justify-content: space-between; align-items: baseline; }
.active-name { font-size: 29rpx; font-weight: 600; }
.active-time { font-size: 36rpx; font-variant-numeric: tabular-nums; }
.focus-scroll { width: calc(100vw - 30rpx); margin-right: -30rpx; }
.focus-row { display: flex; gap: 20rpx; padding-right: 30rpx; }
.focus-card { box-sizing: border-box; width: 490rpx; flex: 0 0 490rpx; padding: 26rpx; background: rgba(255, 252, 247, .46); border-radius: 26rpx; }
.focus-top { display: flex; align-items: center; justify-content: space-between; }
.focus-count { color: var(--muted); font-size: 22rpx; }
.focus-name { margin-top: 24rpx; font-size: 33rpx; font-weight: 630; }
.focus-last { margin-top: 12rpx; color: var(--ink); font-size: 23rpx; }
.focus-meta { margin-top: 10rpx; color: var(--muted); font-size: 23rpx; }
.small-action { box-sizing: border-box; width: 100%; margin-top: 25rpx; padding: 20rpx 0 0; color: var(--caramel-deep); border-top: 1rpx solid rgba(93,74,58,.08); font-size: 25rpx; line-height: 1.2; }
.small-action-hover { opacity: .65; }
.field-label.first { margin-top: 0; }
.context-input { box-sizing: border-box; width: 100%; min-height: 92rpx; margin-top: 26rpx; padding: 22rpx; border-radius: 20rpx; background: rgba(234,225,213,.42); line-height: 1.55; }
.generate-btn { margin-top: 20rpx; width: 100%; }
.breathing { animation: breathe 1.5s ease-in-out infinite; }
.recommend-card { position: relative; display: flex; overflow: hidden; margin-bottom: 18rpx; }
.recommend-accent { width: 8rpx; flex: 0 0 8rpx; opacity: .78; }
.recommend-body { flex: 1; padding: 26rpx 26rpx 22rpx; }
.recommend-head { display: flex; justify-content: space-between; align-items: center; }
.recommend-time { color: var(--muted); font-size: 23rpx; }
.recommend-name { margin-top: 18rpx; font-size: 32rpx; font-weight: 630; }
.recommend-reason { margin-top: 12rpx; color: var(--muted); line-height: 1.6; font-size: 25rpx; }
.plan-link, .recommend-prep, .location-note { margin-top: 12rpx; color: var(--olive); font-size: 22rpx; }
.recommend-prep { color: #8a8279; }
.location-note { color: var(--blue-grey); line-height: 1.5; }
.recommend-actions { display: flex; justify-content: space-between; align-items: center; margin-top: 22rpx; }
.do-btn { margin: 0; padding: 16rpx 24rpx; color: #fffaf4; background: var(--ink); font-size: 24rpx; }
.text-btn { color: var(--muted); font-size: 23rpx; line-height: 1.2; }
.text-btn-hover { opacity: .65; }
.ask-card { display: flex; align-items: center; margin-top: 42rpx; padding: 24rpx; }
.ask-symbol { width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: var(--tab-theme); font-size: 27rpx; }
.ask-copy { flex: 1; display: flex; flex-direction: column; margin-left: 20rpx; }
.ask-title { font-size: 28rpx; font-weight: 620; }
.ask-sub { margin-top: 6rpx; color: var(--muted); font-size: 22rpx; }
.ask-arrow { color: var(--muted); font-size: 48rpx; font-weight: 300; }
@keyframes breathe { 50% { box-shadow: 0 12rpx 44rpx rgba(196,125,96,.34); } }
