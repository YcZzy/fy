<view class="page now-page"><view class="page-content">
  <view class="hero-row">
    <view>
      <text class="eyebrow">此刻 · {{recommendationSource === 'ai' ? '风有回音' : '风月为邻'}}</text>
      <view class="hero-title">{{greeting}}</view>
      <view class="hero-subtitle">这一段空闲，想交给什么？</view>
    </view>
    <view class="settings" bindtap="openSettings" hover-class="settings-hover" aria-role="button" aria-label="设置">
      <image class="settings-icon" src="/assets/settings.svg" mode="aspectFit" aria-hidden="true" />
    </view>
  </view>

  <view wx:if="{{activeSession}}" class="active-card glass-card" bindtap="openActive">
    <view><text class="active-dot"></text><text class="active-label">{{activeSession.status === 'paused' ? '计时已暂停' : '正在计时'}}</text></view>
    <view class="active-main"><text class="active-name">{{activeSession.actionName}}</text><text class="active-time">{{activeElapsed}}</text></view>
  </view>

  <view wx:if="{{pendingAction}}" class="pending-card glass-card card-pad">
    <text class="section-note">刚才去做的事 · 等你回来记录</text><view class="pending-name">{{pendingAction.actionName}}</view>
    <view class="button-row"><button class="primary-btn" bindtap="openPending">留个足迹</button><button class="secondary-btn" bindtap="dismissPending">结束，不记录</button></view>
  </view>
  <view class="thought-section section">
    <view class="section-head"><view><text class="section-title">写下你想做的事</text><text class="section-note">系统会帮你整理，不替你决定</text></view></view>
    <view class="thought-card glass-card card-pad">
      <textarea class="thought-input" auto-height maxlength="500" placeholder="今晚的一个念头，或以后想体验的生活…" placeholder-class="placeholder" value="{{thoughtInput}}" bindinput="onThoughtInput"></textarea>
      <view class="thought-actions"><button class="primary-btn" loading="{{organizingThought}}" disabled="{{!thoughtInput || organizingThought}}" bindtap="organizeThought">{{organizingThought ? '正在整理…' : '帮我整理'}}</button><button class="secondary-btn" disabled="{{!thoughtInput || organizingThought}}" bindtap="keepThought">先记下来</button></view>
    </view>
    <view wx:if="{{thoughtDraft}}" class="thought-draft solid-card">
      <view class="thought-draft-head"><text class="tag">{{thoughtDraft.type === 'plan' ? '计划草稿' : '行动草稿'}}</text><text class="thought-domain">{{thoughtDraft.domainName}}</text></view>
      <view class="thought-draft-name">{{thoughtDraft.name}}</view>
      <view wx:if="{{thoughtDraft.why}}" class="thought-draft-why">{{thoughtDraft.why}}</view>
      <view wx:if="{{thoughtDraft.type === 'action'}}" class="thought-draft-meta">预计 {{thoughtDraft.minutes}} 分钟 · {{thoughtDraft.preparation}}</view>
      <view wx:if="{{thoughtDraft.type === 'plan' && thoughtDraft.actions.length}}" class="thought-steps">
        <view class="thought-steps-title">建议的第一步 · 点按可取消</view>
        <view wx:for="{{thoughtDraft.actions}}" wx:key="draftKey" class="thought-step {{item.included ? '' : 'excluded'}}" data-index="{{index}}" bindtap="toggleThoughtAction"><view class="thought-step-check">{{item.included ? '✓' : ''}}</view><view><text>{{item.name}}</text><text>{{item.minutes}} 分钟</text></view></view>
      </view>
      <view class="thought-draft-actions"><button class="ghost-btn" bindtap="discardThoughtDraft">暂不保存</button><button class="secondary-btn" bindtap="editThoughtDraft">修改</button><button class="primary-btn" bindtap="saveThoughtDraft">确认保存</button></view>
    </view>
    <button wx:if="{{thoughtSavedTarget}}" class="secondary-btn thought-saved" bindtap="openThoughtSaved">{{thoughtSavedTarget.type === 'plan' ? '查看刚保存的计划' : '看看这个行动'}}</button>
  </view>
  <view class="section">
    <view class="section-head"><text class="section-title">不知道做什么？</text><text class="section-note">看看此刻的选择</text></view>
    <view class="state-card glass-card card-pad">
      <view class="field-label first">有多少时间</view>
      <view class="chips"><view wx:for="{{timeOptions}}" wx:key="value" class="chip {{context.minutes === item.value || (item.value === -1 && customTime) ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectTime">{{item.value === -1 && customTime ? context.minutes + " 分钟" : item.label}}</view></view>
      <view class="field-label">现在的力气</view>
      <view class="chips"><view wx:for="{{energyOptions}}" wx:key="value" class="chip {{context.energy === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectEnergy">{{item.label}}</view></view>
      <view class="field-label">在哪里</view>
      <view class="chips"><view wx:for="{{envOptions}}" wx:key="value" class="chip {{context.environment === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectEnvironment">{{item.label}}</view></view>
      <view wx:if="{{context.locationSummary}}" class="location-summary"><text>已选地区：{{context.locationSummary}}</text><button class="ghost-btn" bindtap="clearLocation">清除</button></view>
      <textarea class="context-input" auto-height maxlength="120" placeholder="还可以说一句：今晚只想休息，或最不想做什么…" placeholder-class="placeholder" value="{{context.note}}" bindinput="onNoteInput"></textarea>
    </view>
    <button class="primary-btn generate-btn {{generating ? 'breathing' : ''}}" loading="{{generating}}" bindtap="generate">{{generating ? '正在听风…' : '看看此刻能做什么'}}</button>
  </view>

  <view wx:if="{{recommendations.length}}" class="section results" id="recommendations">
    <view class="section-head"><text class="section-title">此刻可做</text><button class="ghost-btn" bindtap="swapGroup">换一组</button></view>
    <view wx:for="{{recommendations}}" wx:key="id" class="recommend-card solid-card">
      <view class="recommend-accent" style="background: {{item.domainColor}}"></view>
      <view class="recommend-body">
        <view class="recommend-head"><text class="tag">{{item.domainName}}</text><text class="recommend-time">{{item.minutes}} 分钟</text></view>
        <view class="recommend-name">{{item.name}}</view>
        <view class="recommend-reason">{{item.reason}}</view>
        <view wx:if="{{item.planName}}" class="plan-link">来自「{{item.planName}}」</view>
        <view class="recommend-prep">准备：{{item.preparation}}</view>
        <view wx:if="{{item.locationNote}}" class="location-note">{{item.locationNote}}</view>
        <view class="recommend-actions">
          <button class="do-btn" data-id="{{item.id}}" bindtap="chooseAction">就做这个</button>
          <view class="text-btn" data-id="{{item.id}}" bindtap="similarAction" hover-class="text-btn-hover" aria-role="button" aria-label="换个类似的">换个类似的</view>
          <view class="text-btn" data-id="{{item.id}}" bindtap="declineAction" hover-class="text-btn-hover" aria-role="button" aria-label="暂时不想做">暂时不想做</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{hasGenerated && !recommendations.length && !generating}}" class="empty glass-card" id="recommendations">暂时没有符合这些条件的行动。<view>可以调整时间和环境，或添加一件想做的事。</view><button class="secondary-btn" bindtap="addAction">添加行动</button></view>
  <view class="section" wx:if="{{continueActions.length}}">
    <view class="section-head"><text class="section-title">继续一下</text><text class="section-note">最近关注计划里的行动</text></view>
    <scroll-view scroll-x class="focus-scroll" enhanced show-scrollbar="{{false}}">
      <view class="focus-row">
        <view wx:for="{{continueActions}}" wx:key="id" class="focus-card" data-id="{{item.id}}" data-plan-id="{{item.planId}}" bindtap="continueAction">
          <view class="focus-top"><text class="tag">{{item.domainName}}</text><text class="focus-count">{{item.duration}}</text></view>
          <view class="focus-name">{{item.name}}</view>
          <view class="focus-last">来自「{{item.planName}}」</view>
          <view class="focus-meta">{{item.suitableNow ? '适合现在的状态' : '也可以留到合适的时候'}}</view>
          <view class="small-action" hover-class="small-action-hover" aria-role="button" aria-label="看看这个行动">看看这个行动 <text>→</text></view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="ask-card glass-card" bindtap="openChat">
    <view class="ask-symbol">风</view>
    <view class="ask-copy"><text class="ask-title">问风月</text><text class="ask-sub">展开想法、建个计划，或只是聊聊</text></view>
    <text class="ask-arrow">›</text>
  </view>
</view></view>
