.field-label.first { margin-top: 0; }
.picker-value { display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; height: 88rpx; padding: 0 26rpx 0 24rpx; border-radius: 22rpx; background: rgba(255,255,255,.62); border: 1rpx solid rgba(93,74,58,.1); }
.picker-text { min-width: 0; overflow: hidden; line-height: 1.4; white-space: nowrap; text-overflow: ellipsis; }
.picker-arrow { flex-shrink: 0; width: 13rpx; height: 13rpx; margin: -7rpx 2rpx 0 22rpx; border-right: 3rpx solid var(--muted); border-bottom: 3rpx solid var(--muted); transform: rotate(45deg); }
.muted-value { color: var(--muted); }
.focus-toggle { display: flex; align-items: center; justify-content: space-between; margin-top: 30rpx; padding-top: 28rpx; border-top: 1rpx solid rgba(93,74,58,.08); }
.focus-toggle>view:first-child { display: flex; flex-direction: column; gap: 7rpx; }
.toggle-title { font-weight: 600; }
.toggle-sub { color: var(--muted); font-size: 21rpx; }
.switch { width: 86rpx; height: 48rpx; padding: 5rpx; box-sizing: border-box; border-radius: 999rpx; background: #d5cdc4; transition: background .2s; }
.switch view { width: 38rpx; height: 38rpx; border-radius: 50%; background: #fff; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.12); transition: transform .2s; }
.switch.on { background: var(--olive); }
.switch.on view { transform: translateX(38rpx); }
.save-plan { margin-top: 26rpx; }
.plan-stats { display: flex; align-items: center; justify-content: space-around; margin-top: 18rpx; padding: 30rpx 20rpx; }
.plan-stats>view:not(.stats-line) { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.plan-stats>view>text:first-child { font-size: 38rpx; font-weight: 600; }
.plan-stats>view>text:last-child { color: var(--muted); font-size: 21rpx; }
.stats-line { width: 1rpx; height: 58rpx; background: rgba(93,74,58,.1); }
.plan-feelings { display: flex; flex-wrap: wrap; gap: 14rpx 22rpx; margin-top: 15rpx; padding: 18rpx 24rpx; color: var(--muted); font-size: 21rpx; }
.plan-feelings text:first-child { color: var(--ink); font-weight: 600; }
.suitable { color: var(--olive); }
.related-list { overflow: hidden; }
.related-row, .footprint-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 23rpx 25rpx; border-bottom: 1rpx solid rgba(93,74,58,.07); }
.related-row:last-child, .footprint-row:last-child { border-bottom: 0; }
.related-row>view, .footprint-row>view { display: flex; flex-direction: column; gap: 7rpx; }
.related-row>view text:last-child, .footprint-row>view text:last-child, .related-row>text, .footprint-row>text { color: var(--muted); font-size: 21rpx; }
.related-row.selectable { transition: background .18s; }
.related-row.selectable.linked { background: rgba(117,128,107,.09); }
.relation-actions { flex: 0 0 auto; align-items: flex-end; }
.relation-actions .relation-state { color: var(--olive); font-weight: 600; }
.ask-next { width: 100%; margin-top: 16rpx; }
.reflection { position: relative; display: flex; flex-direction: column; gap: 14rpx; padding: 27rpx 60rpx 27rpx 27rpx; color: var(--muted); line-height: 1.65; }
.reflection .section-title { color: var(--ink); }
.reflection .chevron { position: absolute; right: 25rpx; top: 42%; }

.plan-page { padding-bottom: calc(env(safe-area-inset-bottom) + 175rpx); }
.save-dock { position: fixed; z-index: 10; bottom: 0; left: 0; right: 0; padding: 18rpx 30rpx calc(env(safe-area-inset-bottom) + 18rpx); background: var(--theme-surface-solid); border-top: 1rpx solid var(--theme-soft); }
.save-dock button { width: 100%; }
.save-hint { margin-top: 18rpx; color: var(--muted); line-height: 1.6; font-size: 23rpx; }
.delete-plan { margin-top: 28rpx; width: 100%; }
.clear-date { padding: 16rpx 24rpx; color: var(--theme-deep); font-weight: 400; }
.focus-toggle>view:first-child { flex: 1; min-width: 0; }
.switch { flex: 0 0 86rpx; margin-left: 20rpx; }
.toggle-sub { line-height: 1.6; }
.related-row>view:first-child { flex: 1; min-width: 0; }
.relation-actions text { min-height: 62rpx; display: flex; align-items: center; padding: 0 14rpx; }
